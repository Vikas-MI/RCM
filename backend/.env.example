# Backend environment variables
# Copy this file to .env: cp .env.example .env

# PostgreSQL Database URL
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database_name>
# Note: Any '@' in password must be URL-encoded as '%40'
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/smart_rcm_eligibility

# HL7 FHIR Public Server (live test mock EHR API)
HAPI_FHIR_BASE_URL=https://hapi.fhir.org/baseR4

# Application Configuration
APP_NAME=Smart RCM Eligibility
APP_ENV=development
LOG_LEVEL=INFO

# Allowed CORS origins for Next.js frontend (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
